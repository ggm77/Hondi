# ============================================
# 기본 정책: 모든 텍스트 파일은 LF로 고정
# ============================================
* text=auto eol=lf

# ============================================
# Backend (Spring Boot / Java)
# ============================================
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# Gradle/Maven wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf
mvnw text eol=lf
mvnw.cmd text eol=crlf

# ============================================
# Frontend (React / TypeScript / Vite)
# ============================================
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.vue text eol=lf

# ============================================
# 공통 설정/문서 파일
# ============================================
*.md text eol=lf
*.txt text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# ============================================
# 바이너리 파일 (LF 변환 대상 아님, diff/merge 방지)
# ============================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.class binary
*.zip binary
*.pdf binary